# Copy this file to web/config/.env and fill it in.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
HOST=
PORT=
BACKEND_PORT=
NODE_ENV=

# Root user the MongoDB healthcheck creates on first start.
MONGO_USERNAME=
MONGO_PASSWORD=
# User the app connects as (readWrite on "countdown" only). Must differ from MONGO_USERNAME.
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
# mongodb://APP_USER:APP_PASSWORD@localhost:27017/countdown?replicaSet=rs0&authSource=admin
# (password URL-encoded)
MONGO_URI=

# Bearer token for /metrics, at least 16 characters.
METRICS_TOKEN=
