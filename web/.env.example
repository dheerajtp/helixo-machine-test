# Copy this file to web/config/.env and fill it in.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
HOST=
PORT=
BACKEND_PORT=
NODE_ENV=

# Root user the MongoDB healthcheck creates on first start.
MONGO_USERNAME=
MONGO_PASSWORD=
# mongodb://USER:PASSWORD@localhost:27017/countdown?replicaSet=rs0&authSource=admin
# (password URL-encoded)
MONGO_URI=

# Bearer token for /metrics, at least 16 characters.
METRICS_TOKEN=
