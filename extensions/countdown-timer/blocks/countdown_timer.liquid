{%- comment -%} Stays empty until the script fills it; its height is reserved by the stylesheet. {%- endcomment -%}
{%- capture collection_ids -%}
  {%- for collection in product.collections limit: 50 -%}
    {{ collection.id }}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{%- endcapture -%}
<div class="cdt-slot" data-product-id="{{ product.id | escape }}" data-collection-ids="{{ collection_ids | escape }}"></div>
<script src="{{ 'countdown-timer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Countdown timer",
  "target": "content",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "countdown-timer.css",
  "settings": []
}
{% endschema %}
